# Copy this file to `.env` and fill in real values for local development.
# NEVER commit `.env`. Use GitHub Actions Secrets for CI/production secrets.

# --- Application ---
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# For docker-compose:
DATABASE_URL=postgresql+asyncpg://passman:passman@localhost:5432/passman

# --- JWT ---
# Generate a strong secret: `openssl rand -hex 64`
# Required to be a non-default value when ENV=production.
JWT_SECRET=replace-me-with-openssl-rand-hex-64

# --- CORS (comma-separated origins for the API) ---
# Defaults are fine for local dev: http://localhost:5173, chrome-extension://*
# CORS_ORIGINS=["http://localhost:5173","https://vault.example.com"]
