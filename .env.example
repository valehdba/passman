# Copy this file to `.env` and fill in real values for local development.
# NEVER commit `.env`. Use GitHub Actions Secrets for CI/production secrets.

# --- Application ---
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# For docker-compose:
DATABASE_URL=postgresql+asyncpg://passman:passman@localhost:5432/passman

# --- JWT ---
# Generate a strong secret: `openssl rand -hex 64`
# Required to be a non-default value when ENV=production.
JWT_SECRET=replace-me-with-openssl-rand-hex-64

# --- CORS (comma-separated origins for the API) ---
# Defaults are fine for local dev: http://localhost:5173, chrome-extension://*
# CORS_ORIGINS=["http://localhost:5173","https://vault.example.com"]

# =============================================================================
# Docker deployment (docker compose up -d --build)
# Every value below is optional; the defaults shown are used when unset.
# =============================================================================

# --- Bundled Postgres container ---
# POSTGRES_USER=passman
# POSTGRES_PASSWORD=passman      # CHANGE for anything beyond local testing
# POSTGRES_DB=passman

# --- External database instead of the bundled one ---
# Full async URL the API container uses (URL-encode special chars in the password).
# Start without the bundled DB:  docker compose up -d --no-deps api web
# Note: DATABASE_URL above is for running the API on the host; Docker uses this one.
# API_DATABASE_URL=postgresql+asyncpg://user:pass@db.example.com:5432/passman

# --- Published host ports ---
# WEB_PORT=8080
# API_PORT=8000
# POSTGRES_PORT=5432

# --- API behaviour ---
# PASSMAN_ENV=development        # "production" rejects a default JWT_SECRET
# CORS_ORIGINS=["http://localhost:8080"]   # must include the URL you open the vault at
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# LOGIN_ATTEMPTS_PER_15MIN=10
# SERVER_ARGON2_TIME_COST=2
# SERVER_ARGON2_MEMORY_COST=19456
# SERVER_ARGON2_PARALLELISM=1

# --- Trusted devices ("Trust this device" on the OTP step skips the code) ---
# TRUSTED_DEVICE_DEFAULT_DAYS=30   # used when the client sends no period
# TRUSTED_DEVICE_MAX_DAYS=90       # server-side cap on any requested period
# TRUSTED_DEVICE_MAX_PER_USER=10   # oldest trust is evicted beyond this

# --- In-browser SSH terminal (Connect -> "Open shell in new tab") ---
# The API server opens the SSH connection on the user's behalf, so it is
# DENY-BY-DEFAULT: list every target it may reach as a JSON array of IPs, CIDRs,
# hostnames or "*.wildcards". Empty/unset = feature disabled.
# The decrypted password/key is sent to the server for that one session (TLS in
# production), kept in memory only, never logged or stored. Host keys are pinned
# on first use in the passman_data volume.
# SSH_ALLOWED_HOSTS=["10.0.0.0/8","bastion.example.com","*.corp.local"]
